.env.example
APP_NAME=MultimodalRAGPlatform
APP_VERSION=1.0.0
DEBUG=true

DATABASE_URL=postgresql+asyncpg://bank_user:bank_password@localhost:7000/bank_kag

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_db

# Qdrant (primary vector store)
USE_QDRANT=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bank_documents
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine

# Neo4j (knowledge graph)
USE_KG_RETRIEVAL=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
KG_MAX_DEPTH=2
KG_MAX_NODES=100
KG_MAX_DOCS=50
KG_MAX_CHUNKS=200

# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-5.1
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_FALLBACK_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3

UPLOAD_DIR=./uploads
LOG_FILE=./logs/rag.log
LOG_LEVEL=INFO

TOP_K=20
CHUNK_SIZE=1500
CHUNK_OVERLAP=250
MAX_CONTEXT_CHUNKS=10
